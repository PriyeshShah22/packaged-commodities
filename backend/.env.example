# PostgreSQL is the intended production database. SQLite keeps local setup simple.
PACKMETRIX_DATABASE_URL=sqlite:///./packmetrix.db
PACKMETRIX_API_PREFIX=/api/v1
PACKMETRIX_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
PACKMETRIX_AUTH_SECRET=replace-with-a-long-random-production-secret
PACKMETRIX_ACCESS_TOKEN_MINUTES=480
