{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["rule_id", "version", "source_document", "source_url", "rule_reference", "requirement", "applicability", "required_evidence", "validation_type", "severity", "effective_date", "explanation"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_document": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "rule_reference": {"type": "string", "minLength": 1},
    "requirement": {"type": "string", "minLength": 1},
    "applicability": {
      "type": "object",
      "properties": {
        "inspection_modes": {"type": "array", "items": {"type": "string"}},
        "package_contexts": {"type": "array", "items": {"type": "string"}},
        "product_categories": {"type": "array", "items": {"type": "string"}},
        "origins": {"type": "array", "items": {"type": "string"}},
        "sales_contexts": {"type": "array", "items": {"type": "string"}},
        "required_conditions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_type": {"enum": ["presence", "presence_format", "platform_capability"]},
    "validation_config": {"type": "object"},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "effective_date": {"type": "string", "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"},
    "explanation": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
